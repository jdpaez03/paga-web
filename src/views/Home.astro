---
import Base from '../layouts/Base.astro';
import YearStrip from '../components/YearStrip.astro';
import Figures from '../components/Figures.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Uniques from '../components/Uniques.astro';
import { type Lang, company, tx, t, paths, figures, liveProjects, contactPath } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const seo = company.seo.home;
const f = figures();
const live = liveProjects();
// astro-relative-links rewrites href/src, but not data-*: these paths are written relative to the
// page so the site also works from a subfolder, like the preview at /nuevo/
const up = es ? '' : '../';
---
<Base lang={lang} title={tx(seo.title, lang)} description={tx(seo.description, lang)} current="home" alt={paths.home(es ? 'en' : 'es')}>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src="/video/hero.webp" srcset="/video/hero-960.webp 960w, /video/hero.webp 1600w" sizes="100vw" alt="" width="1600" height="900" fetchpriority="high" />
      <video id="hero-video" muted loop playsinline preload="none" width="1280" height="720" data-src={`${up}video/hero-720.mp4`}></video>
    </div>
    <div class="hero-inner">
      <p class="eyebrow">{es ? 'México · USA · Desde 2001' : 'Mexico · USA · Since 2001'}</p>
      <h1>{es ? '25 años' : '25 years'} <span class="accent">{es ? 'desarrollando valor.' : 'developing value.'}</span></h1>
      <div class="ctas">
        <a class="btn light arrow" href={paths.projects(lang)} data-track="cta_click" data-track-where="hero_projects">{es ? 'Proyectos' : 'Projects'}</a>
        <a class="btn" href={contactPath(lang)} data-track="cta_click" data-track-where="hero_contact">{es ? 'Contáctenos' : 'Contact us'}</a>
      </div>
    </div>
    <button type="button" class="film-btn hero-pause" id="hero-btn" aria-pressed="false" hidden>{es ? 'Pausar' : 'Pause'}</button>
  </section>
  <script define:vars={{ es }}>
    (function () {
      var v = document.getElementById('hero-video');
      var b = document.getElementById('hero-btn');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var save = navigator.connection && navigator.connection.saveData;
      // phones keep the still image: the clip would cost ~2 MB of mobile data for a background
      var small = window.matchMedia('(max-width: 760px)').matches;
      if (!v || reduce || save || small) return;
      var start = function () {
      v.src = v.dataset.src;
      v.addEventListener('playing', function () { v.classList.add('on'); });
      var userPaused = false;
      var label = function () { b.textContent = v.paused ? (es ? 'Reproducir' : 'Play') : (es ? 'Pausar' : 'Pause'); b.setAttribute('aria-pressed', String(v.paused)); };
      v.addEventListener('play', label); v.addEventListener('pause', label);
      b.hidden = false;
      b.addEventListener('click', function () { if (v.paused) { userPaused = false; v.play(); } else { userPaused = true; v.pause(); } });
      new IntersectionObserver(function (e) { if (e[0].isIntersecting && !userPaused) v.play().catch(function () {}); else v.pause(); }, { threshold: 0.1 }).observe(v);
      };
      if (document.readyState === 'complete') setTimeout(start, 300); else window.addEventListener('load', function () { setTimeout(start, 300); });
    })();
  </script>

  <section class="section tight">
    <div class="wrap">
      <p class="lead-home">{tx(company.heroLead, lang)}</p>
      <div style="margin-top:40px"><Figures lang={lang} /></div>
    </div>
  </section>

  {/* D1: lo que esta en obra va arriba, no a cinco pantallas de scroll. Un socio de capital
      vino a ver el pipeline —878 unidades y 218,000 m2— y antes se topaba primero con dos
      secciones de mensaje. La trayectoria viene despues: primero lo que pasa hoy. */}
  <section class="section on-white" id="en-desarrollo">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'En desarrollo' : 'In development'}</p>
          <h2>{es ? 'Proyectos en curso' : 'Current projects'}</h2>
        </div>
        <p>{es ? 'Desarrollos en planeación, permisos u obra; donde ya hay fecha, con su año estimado de conclusión.' : 'Developments in planning, permitting or construction; where a date is set, with its estimated completion year.'}</p>
      </div>
      <div class="grid">
        {live.map((p) => <ProjectCard p={p} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section on-deep" id="trayectoria" aria-labelledby="trayectoria-h">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">{es ? 'Trayectoria' : 'Track record'}</p><h2 id="trayectoria-h">{es ? 'De 2001 a hoy' : 'From 2001 to today'}</h2></div>
        <p>{es ? 'Los desarrollos de PAGA por año de conclusión; los años por venir son estimados. La línea completa, con México y Estados Unidos lado a lado, está en Proyectos.' : 'PAGA developments by completion year; future years are estimates. The full timeline, Mexico and the United States side by side, is under Projects.'}</p>
      </div>
    </div>
    <div class="wrap"><YearStrip lang={lang} /></div>
    <div class="wrap">
      <div class="track-actions">
        <a class="btn light arrow" href={paths.projects(lang)}>{es ? `Ver los ${f.developments} desarrollos` : `See all ${f.developments} developments`}</a>
        <a class="btn arrow" href={`${paths.projects(lang)}#linea-del-tiempo`}>{ui.timeline}</a>
      </div>
      {/* Aquí estaba el video institucional de 2:11. Salió del servidor por decisión de Juan
          Diego (5 nov 2026): eran 75 MB en un plan compartido y un visitante de escritorio
          ocupaba un proceso de Apache 47 segundos. Queda la fotografía, que es un cuadro del
          propio video y existe en los dos idiomas. */}
      <figure class="track-photo">
        <img src={es ? '/img/trayectoria-es.webp' : '/img/trayectoria-en.webp'} alt={es ? 'Las Villas, South Padre Island, Texas. Residencial de 38 unidades, entregado en 2005.' : 'Las Villas, South Padre Island, Texas. A 38-unit residential development, delivered in 2005.'} width="1600" height="900" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{es ? 'Propósito' : 'Purpose'}</p>
      <p class="statement"><span class="accent">{tx(company.purpose, lang)}</span> {tx(company.niche, lang)}</p>
      <p style="margin-top:40px"><a class="btn arrow" href={paths.about(lang)}>{ui.nav.about}</a></p>
    </div>
  </section>

  {/* El proceso, en el Inicio y no solo en Nosotros. A un socio de capital o a un banco le dice
      mas «asi se estructura un proyecto aqui, de la oportunidad a la entrega» que cualquier
      adjetivo. Los seis pasos salen de company.json, los mismos que en Nosotros. */}
  <section class="section" id="proceso" aria-labelledby="proceso-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'Proceso' : 'Process'}</p>
          <h2 id="proceso-h">{es ? 'Seis pasos, de la oportunidad a la entrega' : 'Six steps, from opportunity to delivery'}</h2>
        </div>
        <p>{es ? 'El mismo proceso en los 36 desarrollos, en México y en Estados Unidos.' : 'The same process across all 36 developments, in Mexico and the United States.'}</p>
      </div>
      <ol class="process-line">
        {company.process.map((s, i) => (
          <li><b class="num">0{i + 1}</b><span>{tx(s.name, lang)}</span></li>
        ))}
      </ol>
      <p style="margin-top:32px"><a class="btn arrow" href={`${paths.about(lang)}#proceso`}>{es ? 'Cómo trabajamos' : 'How we work'}</a></p>
    </div>
  </section>

  {/* Despues del proceso, con quien. El texto es `partnerTeaser` de company.json, escrito para
      propietarios de terrenos, socios de capital y codesarrolladores, y hasta hoy no se
      renderizaba en ninguna parte. La liga va al formulario sin perfil preseleccionado: el
      visitante elige el suyo ahi (decision de Juan Diego, 13 oct 2026). */}
  <section class="section on-white" id="socios" aria-labelledby="socios-h">
    <div class="wrap partner-block">
      <p class="eyebrow">{es ? 'Con quién desarrollamos' : 'Who we develop with'}</p>
      <h2 id="socios-h">{tx(company.partnerTeaser.title, lang)}</h2>
      <p class="partner-text">{tx(company.partnerTeaser.text, lang)}</p>
      <p style="margin-top:32px"><a class="btn solid arrow" href={contactPath(lang)} data-track="cta_click" data-track-where="partners">{tx(company.partnerTeaser.cta, lang)}</a></p>
    </div>
  </section>

  <section class="section on-dark" aria-labelledby="uniques-h">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'Por qué PAGA' : 'Why PAGA'}</p>
          <h2 id="uniques-h">{es ? 'Tres cosas que nos distinguen' : 'Three things that set us apart'}</h2>
        </div>
      </div>
      <Uniques lang={lang} />
    </div>
  </section>

</Base>
