---
import Base from '../layouts/Base.astro';
import YearStrip from '../components/YearStrip.astro';
import { type Lang, company, tx, t, paths, projects, figures, area, asOf, srcset, liveProjects, contactPath, typeLabel } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const seo = company.seo.home;
const f = figures();
const bySlug = (s: string) => projects.find((p) => p.slug === s)!;
// first screen: delivered work across both countries and every business line
const tiles = ['via-puerta-de-hierro', 'los-corales', 'torre-pietra', 'parkview-pitic', 'cinnamon-shore-five-town-center'].map(bySlug);
const live = liveProjects();
const asOfLabel = new Date(asOf + 'T12:00:00').toLocaleDateString(es ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' });
const areaShort = area(f.totalFt2, lang, 1000).replace(/ (m²|ft²)$/, '');
---
<Base lang={lang} title={tx(seo.title, lang)} description={tx(seo.description, lang)} current="home" alt={paths.home(es ? 'en' : 'es')}>
  <section class="intro">
    <div class="intro-text">
      <p class="eyebrow">PAGA Desarrollos · {es ? 'México y Texas, desde 2001' : 'Mexico and Texas, since 2001'}</p>
      <h1>{es ? '25 años' : '25 years'} <span class="accent">{es ? 'desarrollando valor.' : 'developing value.'}</span></h1>
      <p class="lead">{tx(company.heroLead, lang)}</p>
      <p class="audience">{es ? 'Trabajamos con propietarios de tierra, socios de capital, instituciones financieras y compradores.' : 'We work with landowners, capital partners, financial institutions and buyers.'}</p>
      <div class="ctas">
        <a class="btn solid arrow" href="#en-desarrollo" data-track="cta_click" data-track-where="hero_live">{es ? 'Proyectos en desarrollo' : 'Projects in development'}</a>
        <a class="btn" href={contactPath(lang)} data-track="cta_click" data-track-where="hero_contact">{es ? 'Hablemos' : "Let's talk"}</a>
      </div>
      <div class="kpis num">
        <div><strong>{f.years}</strong><span>{es ? 'años' : 'years'}</span></div>
        <div><strong>{f.developments}</strong><span>{es ? 'desarrollos' : 'developments'}</span></div>
        <div><strong>{f.delivered}</strong><span>{es ? 'entregados' : 'delivered'}</span></div>
        <div><strong>{areaShort}</strong><span>{es ? 'm² construidos y en desarrollo' : 'ft² built and in development'}</span></div>
      </div>
      <p class="kpis-note">{es ? `Cifras a ${asOfLabel}.` : `Figures as of ${asOfLabel}.`}</p>
    </div>
    <div class="mosaic">
      {tiles.map((p, i) => (
        <a class:list={['tile', `t${i + 1}`]} href={paths.project(lang, p.slug)}>
          <img src={p.image} srcset={srcset(p.image, p.imageSize[0])} sizes={i === 0 ? '(min-width: 1000px) 20vw, 100vw' : '(min-width: 1000px) 20vw, 50vw'} alt={p.name} width={p.imageSize[0]} height={p.imageSize[1]} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
          <figcaption><b>{p.name}</b>{p.city}, {p.state} · {p.completionYear}</figcaption>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="en-desarrollo">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'En desarrollo' : 'In development'}</p>
          <h2>{es ? 'Proyectos en curso' : 'Current projects'}</h2>
        </div>
        <p>{es ? 'Desarrollos en planeación, permisos u obra. Si te interesa alguno, te conectamos con su equipo comercial.' : 'Developments in planning, permitting or construction. If one interests you, we will connect you with its sales team.'}</p>
      </div>
      <div class="grid">
        {live.map((p) => (
          <article class="card">
            <a href={paths.project(lang, p.slug)} style="text-decoration:none;color:inherit;display:block">
              <div class="ph"><img src={p.image} srcset={srcset(p.image, p.imageSize[0])} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" alt={p.name} width={p.imageSize[0]} height={p.imageSize[1]} loading="lazy" decoding="async" /></div>
              <h3>{p.name}</h3>
              <div class="meta"><span>{p.city}, {p.state}</span><span>{tx(typeLabel[p.type], lang)}</span>{p.completionYear && <span class="num">{es ? 'Estimado' : 'Est.'} {p.completionYear}</span>}</div>
            </a>
            <p style="margin:10px 0 0;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center">
              <span class="tag live">{ui.status[p.status as keyof typeof ui.status]}</span>
              {p.salesUrl
                ? <a class="card-cta" href={p.salesUrl} target="_blank" rel="noopener" data-track="outbound_sales_site" data-track-where={p.slug}>{es ? 'Sitio del proyecto' : 'Project website'} ↗</a>
                : <a class="card-cta" href={contactPath(lang, { perfil: 'comprador', proyecto: p.slug })} data-track="cta_click" data-track-where={`live_${p.slug}`}>{es ? 'Solicitar información' : 'Request information'} →</a>}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="film" aria-label={es ? 'Recorrido aéreo por Sonoma y Balcones' : 'Aerial tour of Sonoma and Balcones'}>
    <video id="film" muted loop playsinline preload="none" poster="/video/paga-recorrido.jpg" width="1920" height="1080">
      <source src="/video/paga-recorrido-movil.mp4" type="video/mp4" media="(max-width: 760px)" />
      <source src="/video/paga-recorrido.mp4" type="video/mp4" />
    </video>
    <div class="film-cap wrap">
      <p class="eyebrow">{es ? 'Recorrido aéreo' : 'Aerial tour'}</p>
      <p>{es ? 'Sonoma Club & Residences y Balcones Residencial, Monterrey.' : 'Sonoma Club & Residences and Balcones Residencial, Monterrey.'}</p>
      <button type="button" class="film-btn" id="film-btn" aria-pressed="false">{es ? 'Pausar' : 'Pause'}</button>
    </div>
  </section>
  <script define:vars={{ es }}>
    const v = document.getElementById('film');
    const b = document.getElementById('film-btn');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const set = (playing) => { b.textContent = playing ? (es ? 'Pausar' : 'Pause') : (es ? 'Reproducir' : 'Play'); b.setAttribute('aria-pressed', String(!playing)); };
    if (!reduce) {
      let tracked = false;
      const io = new IntersectionObserver(([e]) => { if (e.isIntersecting && b.getAttribute('aria-pressed') === 'false') { v.play().catch(() => {}); if (!tracked && window.va) { tracked = true; window.va('event', { name: 'video_play' }); } } else v.pause(); }, { threshold: 0.25 });
      io.observe(v);
    } else set(false);
    b.addEventListener('click', () => { if (v.paused) { v.play(); set(true); } else { v.pause(); set(false); } });
  </script>


  <section class="section tight on-deep">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">{es ? 'Trayectoria' : 'Track record'}</p><h2>{es ? 'De 2001 a hoy' : 'From 2001 to today'}</h2></div>
        <p>{es ? 'Recorre cada año. La línea completa, con México y Texas lado a lado, está en Proyectos.' : 'Scroll through each year. The full timeline, Mexico and Texas side by side, is under Projects.'}</p>
      </div>
    </div>
    <div class="wrap"><YearStrip lang={lang} /></div>
    <div class="wrap"><p style="margin-top:32px;display:flex;flex-wrap:wrap;gap:12px"><a class="btn light arrow" href={paths.projects(lang)}>{es ? `Ver los ${f.developments} desarrollos` : `See all ${f.developments} developments`}</a><a class="btn arrow" href={`${paths.projects(lang)}#linea-del-tiempo`}>{ui.timeline}</a></p></div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{es ? 'Propósito' : 'Purpose'}</p>
      <p class="statement"><span class="accent">{tx(company.purpose, lang)}</span> {tx(company.niche, lang)}</p>
      <p style="margin-top:40px"><a class="btn arrow" href={paths.about(lang)}>{ui.nav.about}</a></p>
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'Por qué PAGA' : 'Why PAGA'}</p>
          <h2>{es ? 'Tres cosas que nos distinguen' : 'Three things that set us apart'}</h2>
        </div>
      </div>
      <div class="uniques">
        {company.uniques.map((u, i) => (
          <div class="unique"><b>0{i + 1}</b><h3>{tx(u.name, lang)}</h3><p>{tx(u.text, lang)}</p></div>
        ))}
      </div>
    </div>
  </section>

</Base>
