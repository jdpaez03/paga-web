---
import Base from '../layouts/Base.astro';
import YearStrip from '../components/YearStrip.astro';
import { type Lang, company, tx, t, paths, projects, figures, area, asOf, srcset, liveProjects, contactPath, typeLabel } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const seo = company.seo.home;
const f = figures();
const live = liveProjects();
const asOfLabel = new Date(asOf + 'T12:00:00').toLocaleDateString(es ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' });
const areaShort = area(f.totalFt2, lang, 1000).replace(/ (m²|ft²)$/, '');
---
<Base lang={lang} title={tx(seo.title, lang)} description={tx(seo.description, lang)} current="home" alt={paths.home(es ? 'en' : 'es')}>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src="/video/hero.webp" srcset="/video/hero-960.webp 960w, /video/hero.webp 1600w" sizes="100vw" alt="" width="1600" height="900" fetchpriority="high" />
      <video id="hero-video" muted loop playsinline preload="none" width="1920" height="1080" data-src-sm="/video/hero-720.mp4" data-src-lg="/video/hero-1080.mp4"></video>
    </div>
    <div class="hero-inner">
      <p class="eyebrow">PAGA Desarrollos · {es ? 'México y Texas, desde 2001' : 'Mexico and Texas, since 2001'}</p>
      <h1>{es ? '25 años' : '25 years'} <span class="accent">{es ? 'desarrollando valor.' : 'developing value.'}</span></h1>
      <p class="lead">{tx(company.heroLead, lang)}</p>
      <p class="audience">{es ? 'Trabajamos con propietarios de tierra, socios de capital, instituciones financieras y codesarrolladores.' : 'We work with landowners, capital partners, financial institutions and co-developers.'}</p>
      <div class="ctas">
        <a class="btn light arrow" href={contactPath(lang, { perfil: 'inversion' })} data-track="cta_click" data-track-where="hero_invest">{es ? 'Invertir o asociarse' : 'Invest or partner'}</a>
        <a class="btn" href={contactPath(lang, { perfil: 'terreno' })} data-track="cta_click" data-track-where="hero_land">{es ? 'Tengo un terreno' : 'I own land'}</a>
      </div>
      <p class="hero-buy">{es ? '¿Buscas comprar? ' : 'Looking to buy? '}<a href="#en-desarrollo" data-track="cta_click" data-track-where="hero_live">{es ? 'Ve los proyectos en desarrollo' : 'See projects in development'} ↓</a></p>
      <div class="hero-foot">
        <div class="kpis num">
          <div><strong>{f.years}</strong><span>{es ? 'años' : 'years'}</span></div>
          <div><strong>{f.developments}</strong><span>{es ? 'desarrollos' : 'developments'}</span></div>
          <div><strong>{f.delivered}</strong><span>{es ? 'entregados' : 'delivered'}</span></div>
          <div><strong>{areaShort}</strong><span>{es ? 'm² construidos y en desarrollo' : 'ft² built and in development'}</span></div>
        </div>
        <div class="hero-cap">
          <p class="kpis-note">{es ? `Cifras a ${asOfLabel}.` : `Figures as of ${asOfLabel}.`} {es ? 'En video: Sonoma y Balcones, Monterrey.' : 'On video: Sonoma and Balcones, Monterrey.'}</p>
          <button type="button" class="film-btn" id="hero-btn" aria-pressed="false" hidden>{es ? 'Pausar' : 'Pause'}</button>
        </div>
      </div>
    </div>
  </section>
  <script define:vars={{ es }}>
    (function () {
      var v = document.getElementById('hero-video');
      var b = document.getElementById('hero-btn');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var save = navigator.connection && navigator.connection.saveData;
      if (!v || reduce || save) return;
      var start = function () {
      v.src = window.matchMedia('(max-width: 760px)').matches ? v.dataset.srcSm : v.dataset.srcLg;
      v.addEventListener('playing', function () { v.classList.add('on'); });
      var userPaused = false;
      var label = function () { b.textContent = v.paused ? (es ? 'Reproducir' : 'Play') : (es ? 'Pausar' : 'Pause'); b.setAttribute('aria-pressed', String(v.paused)); };
      v.addEventListener('play', label); v.addEventListener('pause', label);
      b.hidden = false;
      b.addEventListener('click', function () { if (v.paused) { userPaused = false; v.play(); } else { userPaused = true; v.pause(); } });
      new IntersectionObserver(function (e) { if (e[0].isIntersecting && !userPaused) v.play().catch(function () {}); else v.pause(); }, { threshold: 0.1 }).observe(v);
      };
      if (document.readyState === 'complete') setTimeout(start, 300); else window.addEventListener('load', function () { setTimeout(start, 300); });
    })();
  </script>

  <section class="section" id="en-desarrollo">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'En desarrollo' : 'In development'}</p>
          <h2>{es ? 'Proyectos en curso' : 'Current projects'}</h2>
        </div>
        <p>{es ? 'Desarrollos en planeación, permisos u obra. Si te interesa alguno, te conectamos con su equipo comercial.' : 'Developments in planning, permitting or construction. If one interests you, we will connect you with its sales team.'}</p>
      </div>
      <div class="grid">
        {live.map((p) => (
          <article class="card">
            <a href={paths.project(lang, p.slug)} style="text-decoration:none;color:inherit;display:block">
              <div class="ph"><img src={p.image} srcset={srcset(p.image, p.imageSize[0])} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" alt={p.name} width={p.imageSize[0]} height={p.imageSize[1]} loading="lazy" decoding="async" /></div>
              <h3>{p.name}</h3>
              <div class="meta"><span>{p.city}, {p.state}</span><span>{tx(typeLabel[p.type], lang)}</span>{p.completionYear && <span class="num">{es ? 'Estimado' : 'Est.'} {p.completionYear}</span>}</div>
            </a>
            <p style="margin:10px 0 0;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center">
              <span class="tag live">{ui.status[p.status as keyof typeof ui.status]}</span>
              {p.salesUrl
                ? <a class="card-cta" href={p.salesUrl} target="_blank" rel="noopener" data-track="outbound_sales_site" data-track-where={p.slug}>{es ? 'Sitio del proyecto' : 'Project website'} ↗</a>
                : <a class="card-cta" href={contactPath(lang, { perfil: 'comprador', proyecto: p.slug })} data-track="cta_click" data-track-where={`live_${p.slug}`}>{es ? 'Solicitar información' : 'Request information'} →</a>}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section on-dark film-full" aria-labelledby="film-h">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">{es ? `${f.developments} desarrollos` : `${f.developments} developments`}</p><h2 id="film-h">{es ? '25 años en dos minutos' : '25 years in two minutes'}</h2></div>
        <p>{es ? 'Cada desarrollo de PAGA, de Los Robles en 2001 a Torre Acqua, con su año de conclusión, ciudad y estatus. Video sin audio.' : 'Every PAGA development, from Los Robles in 2001 to Torre Acqua, with its completion year, city and status. No sound.'}</p>
      </div>
      <div class="film-frame">
        <video id="film" controls playsinline preload="none" poster={es ? '/video/paga-25-anos.webp' : '/video/paga-25-years.webp'} width="1920" height="1080">
          <source src={es ? '/video/paga-25-anos-720.mp4' : '/video/paga-25-years-720.mp4'} type="video/mp4" media="(max-width: 760px)" />
          <source src={es ? '/video/paga-25-anos.mp4' : '/video/paga-25-years.mp4'} type="video/mp4" />
        </video>
        <button type="button" class="film-play" id="film-play" data-track="video_play" data-track-where={`home_film_${lang}`}><span aria-hidden="true">▶</span> {es ? 'Ver el video' : 'Watch the film'} · 2:11</button>
      </div>
    </div>
  </section>
  <script>
    const film = document.getElementById('film') as HTMLVideoElement | null;
    const play = document.getElementById('film-play');
    if (film && play) {
      play.addEventListener('click', () => { play.hidden = true; film.play().catch(() => {}); });
      film.addEventListener('play', () => { play.hidden = true; });
    }
  </script>


  <section class="section tight on-deep">
    <div class="wrap">
      <div class="section-head split">
        <div><p class="eyebrow">{es ? 'Trayectoria' : 'Track record'}</p><h2>{es ? 'De 2001 a hoy' : 'From 2001 to today'}</h2></div>
        <p>{es ? 'Recorre cada año. La línea completa, con México y Texas lado a lado, está en Proyectos.' : 'Scroll through each year. The full timeline, Mexico and Texas side by side, is under Projects.'}</p>
      </div>
    </div>
    <div class="wrap"><YearStrip lang={lang} /></div>
    <div class="wrap"><p style="margin-top:32px;display:flex;flex-wrap:wrap;gap:12px"><a class="btn light arrow" href={paths.projects(lang)}>{es ? `Ver los ${f.developments} desarrollos` : `See all ${f.developments} developments`}</a><a class="btn arrow" href={`${paths.projects(lang)}#linea-del-tiempo`}>{ui.timeline}</a></p></div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{es ? 'Propósito' : 'Purpose'}</p>
      <p class="statement"><span class="accent">{tx(company.purpose, lang)}</span> {tx(company.niche, lang)}</p>
      <p style="margin-top:40px"><a class="btn arrow" href={paths.about(lang)}>{ui.nav.about}</a></p>
    </div>
  </section>

  <section class="section on-dark">
    <div class="wrap">
      <div class="section-head split">
        <div>
          <p class="eyebrow">{es ? 'Por qué PAGA' : 'Why PAGA'}</p>
          <h2>{es ? 'Tres cosas que nos distinguen' : 'Three things that set us apart'}</h2>
        </div>
      </div>
      <div class="uniques">
        {company.uniques.map((u, i) => (
          <div class="unique"><b>0{i + 1}</b><h3>{tx(u.name, lang)}</h3><p>{tx(u.text, lang)}</p></div>
        ))}
      </div>
    </div>
  </section>

</Base>
