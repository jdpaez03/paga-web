---
import Base from '../layouts/Base.astro';
import contact from '../data/contact.json';
import { type Lang, tx, paths, liveProjects, contactPath, offices } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const F = contact.fields;
const live = liveProjects();
const sales = Object.fromEntries(live.filter((p) => p.salesUrl).map((p) => [p.slug, p.salesUrl]));
const msgs = { ok: tx(contact.ok, lang), pending: tx(contact.pending, lang), error: tx(contact.error, lang), sendError: tx(contact.sendError, lang), salesHint: tx(contact.salesHint, lang) };
// The form posts to the PHP connector of the cPanel (public/api/contact.php). The path is relative
// to this page — /contacto/ is one level deep, /en/contact/ two — so the site also works from a
// subfolder, as in the preview at /nuevo/.
const endpoint = (es ? '../' : '../../') + 'api/contact.php';
---
<Base lang={lang} title={`${tx(contact.title, lang)} · PAGA Desarrollos`} description={tx(contact.lead, lang)} current="contact" alt={contactPath(es ? 'en' : 'es')} hideCta>
  <section class="section contact">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">{es ? 'Contacto' : 'Contact'}</p>
        <h1>{tx(contact.title, lang)}</h1>
        <p class="lead">{tx(contact.lead, lang)}</p>
        <aside class="contact-side">
          <h2>{tx(contact.side.title, lang)}</h2>
          <ul>
            {contact.side.items[lang].map((t, i) => (
              <li>{i === 1 ? <>{t.split(es ? 'Consulta' : 'See our')[0]}<a href={paths.legal(lang, 'canales-oficiales')}>{es ? 'Consulta nuestros canales oficiales.' : 'See our official channels.'}</a></> : t}</li>
            ))}
          </ul>
          {offices.length > 0 && (
            <div class="offices">
              <h2>{tx(contact.officesTitle, lang)}</h2>
              {offices.map((o) => (
                <address>
                  <strong>{tx(o.city, lang)}</strong><br />
                  {o.address}
                  {o.phone && <><br /><a href={`tel:${o.phone.replace(/[^\d+]/g, '')}`}>{o.phone}</a></>}
                  {o.email && <><br /><a href={`mailto:${o.email}`}>{o.email}</a></>}
                </address>
              ))}
            </div>
          )}
        </aside>
      </div>

      <form id="contact-form" class="form" novalidate data-endpoint={endpoint} data-ok={msgs.ok} data-pending={msgs.pending} data-error={msgs.error} data-send-error={msgs.sendError} data-sales-hint={msgs.salesHint} data-sales={JSON.stringify(sales)} data-lang={lang}>
        <p class="form-req">* {tx(contact.required, lang)}</p>
        <fieldset class="profiles" id="f-profiles" aria-describedby="err-profile">
          <legend>{tx(F.profile, lang)} <b class="req" aria-hidden="true">*</b></legend>
          {contact.profiles.map((pr, i) => (
            <label class="chip-radio">
              <input type="radio" name="profile" value={pr.id} required data-hint={pr.hint[lang]} />
              <span>{pr[lang]}</span>
            </label>
          ))}
        </fieldset>
        <span class="field-error" id="err-profile">{tx(contact.errors.profile, lang)}</span>
        <p class="hint" id="profile-hint" aria-live="polite"></p>

        <div class="row">
          <label class="field"><span>{tx(F.name, lang)} <b class="req" aria-hidden="true">*</b></span><input id="f-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="err-name" /><span class="field-error" id="err-name">{tx(contact.errors.name, lang)}</span></label>
          <label class="field"><span>{tx(F.email, lang)} <b class="req" aria-hidden="true">*</b></span><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="err-email" /><span class="field-error" id="err-email">{tx(contact.errors.email, lang)}</span></label>
        </div>
        <div class="row">
          <label class="field"><span>{tx(F.phone, lang)}</span><input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
          <label class="field"><span>{tx(F.company, lang)}</span><input id="f-company" name="company" autocomplete="organization" maxlength="120" /></label>
        </div>

        <div class="row only" data-for="terreno" hidden>
          <label class="field"><span>{tx(F.landLocation, lang)}</span><input id="f-land-loc" name="landLocation" maxlength="200" /></label>
          <label class="field"><span>{tx(F.landArea, lang)}</span><input id="f-land-area" name="landArea" inputmode="numeric" maxlength="20" /></label>
        </div>
        <div class="only" data-for="comprador" hidden>
          <label class="field"><span>{tx(F.project, lang)}</span>
            <select id="f-project" name="project">
              <option value="">{tx(F.projectAny, lang)}</option>
              {live.map((p) => <option value={p.slug}>{p.name} · {p.city}</option>)}
            </select>
          </label>
          <p class="hint" id="sales-link" hidden></p>
        </div>

        <label class="field"><span>{tx(F.message, lang)} <b class="req" aria-hidden="true">*</b></span><textarea id="f-message" name="message" rows="5" required maxlength="3000" aria-describedby="err-message"></textarea><span class="field-error" id="err-message">{tx(contact.errors.message, lang)}</span></label>

        <label class="check only" data-for="inversion terreno banco"><input id="f-deck" type="checkbox" name="deck" value="1" /> <span>{tx(F.deck, lang)}</span></label>
        <label class="check"><input id="f-consent" type="checkbox" name="consent" value="1" required aria-describedby="err-consent" /> <span>{tx(F.consent, lang)} <a href={paths.legal(lang, 'aviso-de-privacidad')} target="_blank" rel="noopener">{tx(F.consentLink, lang)}</a>. <b class="req" aria-hidden="true">*</b><span class="field-error" id="err-consent">{tx(contact.errors.consent, lang)}</span></span></label>
        <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>

        <button class="btn solid arrow" type="submit" id="f-submit">{tx(F.submit, lang)}</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const hint = document.getElementById('profile-hint')!;
    const salesBox = document.getElementById('sales-link')!;
    const sales = JSON.parse(form.dataset.sales || '{}');
    const projSel = document.getElementById('f-project') as HTMLSelectElement;
    // a visitor who arrives from a project page keeps that project in view whatever profile they choose
    let keepProject = false;
    const track = (name: string, data: Record<string, string> = {}) => (window as any).va?.('event', { name, data });

    const apply = () => {
      const r = form.querySelector<HTMLInputElement>('input[name=profile]:checked');
      hint.textContent = r ? r.dataset.hint || '' : '';
      form.querySelectorAll<HTMLElement>('.only').forEach((el) => {
        const forProfile = !!r && (el.dataset.for || '').split(' ').includes(r.value);
        el.hidden = !(forProfile || (keepProject && el.contains(projSel)));
      });
    };
    const showSales = () => {
      const sel = projSel;
      const url = sales[sel.value];
      // availability and prices only matter to buyers and brokers (or before a profile is chosen)
      const r = form.querySelector<HTMLInputElement>('input[name=profile]:checked');
      const forSales = !r || ['comprador', 'broker'].includes(r.value);
      salesBox.hidden = !url || !forSales;
      if (url) { salesBox.innerHTML = ''; salesBox.append(form.dataset.salesHint + ' '); const a = document.createElement('a'); a.href = url; a.target = '_blank'; a.rel = 'noopener'; a.textContent = url.replace(/^https?:\/\/(www\.)?/, ''); a.addEventListener('click', () => track('outbound_sales_site', { project: sel.value, from: 'contact' })); salesBox.append(a); }
    };

    // prefill from ?perfil=…&proyecto=…
    const q = new URLSearchParams(location.search);
    const pre = q.get('perfil') || q.get('profile');
    if (pre) { const r = form.querySelector<HTMLInputElement>(`input[name=profile][value="${CSS.escape(pre)}"]`); if (r) r.checked = true; }
    const proj = q.get('proyecto') || q.get('project');
    if (proj) { projSel.value = proj; keepProject = projSel.value === proj; }
    apply(); showSales();
    form.addEventListener('change', (e) => { const t = e.target as HTMLInputElement; if (t.name === 'profile') { apply(); showSales(); track('route_select', { profile: t.value }); } if (t.name === 'project') showSales(); });
    let started = false;
    form.addEventListener('input', () => { if (!started) { started = true; track('form_start'); } }, { once: false });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('f-submit') as HTMLButtonElement;
      if (btn.disabled) return;
      form.querySelectorAll('.invalid').forEach((el) => el.classList.remove('invalid'));
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll('.field-error.on').forEach((el) => el.classList.remove('on'));
      const bad = [...form.querySelectorAll<HTMLInputElement>('input[required]:not([type=radio]), textarea[required]')].filter((el) => !el.closest('[hidden]') && !el.checkValidity());
      const noProfile = !form.querySelector('input[name=profile]:checked');
      const profiles = form.querySelector('.profiles')!;
      if (noProfile) { profiles.classList.add('invalid'); profiles.setAttribute('aria-invalid', 'true'); document.getElementById('err-profile')!.classList.add('on'); }
      if (bad.length || noProfile) {
        // the red border alone leaves out anyone who cannot see it: every field says what is missing
        bad.forEach((el) => {
          el.setAttribute('aria-invalid', 'true');
          (el.closest('.field, .check') || el).classList.add('invalid');
          const msg = el.getAttribute('aria-describedby');
          if (msg) document.getElementById(msg)?.classList.add('on');
        });
        status.textContent = form.dataset.error!; (noProfile ? form.querySelector<HTMLInputElement>('input[name=profile]')! : bad[0]).focus(); track('form_error'); return;
      }
      const fd = new FormData(form);
      form.querySelectorAll<HTMLElement>('.only[hidden] [name]').forEach((el) => fd.delete((el as HTMLInputElement).name));
      const data: Record<string, any> = Object.fromEntries(fd as any);
      data.lang = form.dataset.lang; data.page = location.pathname;
      // the slug alone ("torre-acqua") says little in the email: send the name as it reads on screen
      if (data.project) data.projectName = (projSel.selectedOptions[0]?.textContent || '').trim();
      try { const src = JSON.parse(sessionStorage.getItem('paga_src') || '{}'); data.srcLanding = src.landing || ''; data.srcRef = src.ref || ''; data.srcUtm = src.utm || ''; } catch { /* no session storage */ }
      btn.disabled = true; status.textContent = '…';
      try {
        const res = await fetch(form.dataset.endpoint || 'api/contact.php', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        if (res.ok) { form.reset(); keepProject = false; apply(); showSales(); status.textContent = form.dataset.ok!; track('form_submit', { profile: String(data.profile) }); }
        else if (res.status === 400) { status.textContent = form.dataset.error!; track('form_error'); }
        else if ([404, 405, 501, 503].includes(res.status)) { status.textContent = form.dataset.pending!; }
        else { status.textContent = form.dataset.sendError!; track('form_error'); }
      } catch { status.textContent = form.dataset.sendError!; }
      finally { btn.disabled = false; }
    });
  </script>
</Base>
