---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import descriptions from '../data/descriptions.json';
import { type Lang, type Project, t, tx, paths, typeLabel, masterPlans, countryLabel, area, num, sortedByYear, projects, asOf, srcset, contactPath } from '../lib/data';
interface Props { lang: Lang; p: Project }
const { lang, p } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const live = p.status !== 'delivered';
const ordered = sortedByYear();
const i = ordered.findIndex((x) => x.slug === p.slug);
const prev = ordered[i - 1];
const next = ordered[i + 1];
const siblings = p.masterPlan ? projects.filter((x) => x.masterPlan === p.masterPlan && x.slug !== p.slug) : [];
const typeTxt = tx(typeLabel[p.type], lang);
const title = `${p.name} · PAGA Desarrollos`;
const typePhrase: Record<string, { es: string; en: string }> = {
  residencial: { es: 'desarrollo residencial', en: 'a residential development' },
  comercial: { es: 'desarrollo comercial', en: 'a retail development' },
  oficinas: { es: 'desarrollo de oficinas', en: 'an office development' },
  'usos-mixtos': { es: 'desarrollo de usos mixtos', en: 'a mixed-use development' },
};
const place = `${p.city}, ${p.state}`.replace(/\.$/, '');
const longDesc = (descriptions as any)[p.slug]?.[lang] as string | undefined;
const desc = longDesc && longDesc.length <= 160 ? longDesc : es
  ? `${p.name}, ${typePhrase[p.type].es} de PAGA Desarrollos en ${place}${p.completionYear ? `, ${live ? 'conclusión estimada' : 'concluido en'} ${p.completionYear}` : ''}.`
  : `${p.name}, ${typePhrase[p.type].en} by PAGA Desarrollos in ${place}${p.completionYear ? `, ${live ? 'estimated completion' : 'completed in'} ${p.completionYear}` : ''}.`;
const ld = {
  '@context': 'https://schema.org', '@type': p.type === 'residencial' ? 'ApartmentComplex' : 'Place', name: p.name,
  description: longDesc ?? desc, image: new URL(p.image, 'https://pagadesarrollos.com').href,
  address: { '@type': 'PostalAddress', addressLocality: p.city, addressRegion: p.state, addressCountry: p.country === 'MX' ? 'MX' : 'US' },
  ...(p.units ? { numberOfAccommodationUnits: p.units } : {}),
};
const asOfLabel = new Date(asOf + 'T12:00:00').toLocaleDateString(es ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' });
---
<Base lang={lang} title={title} description={desc} current="projects" alt={paths.project(es ? 'en' : 'es', p.slug)} image={`/img/og/${p.slug}.jpg`} jsonLd={ld} hideCta>
  <section class="p-top">
    <div class="p-media">
      <figure class="p-main">
        <img id="p-main-img" src={p.image} srcset={srcset(p.image, p.imageSize[0])} sizes="(min-width: 1000px) 60vw, 100vw" alt={p.name} width={p.imageSize[0]} height={p.imageSize[1]} fetchpriority="high" />
      </figure>
      {p.gallery.length > 0 && (
        <div class="p-thumbs" role="group" aria-label={es ? 'Galería' : 'Gallery'}>
          {[{ src: p.image, size: p.imageSize }, ...p.gallery].map((g, i) => (
            <button type="button" class="p-thumb" data-src={g.src} data-srcset={srcset(g.src, g.size[0])} data-w={g.size[0]} data-h={g.size[1]} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${p.name}, ${es ? 'imagen' : 'image'} ${i + 1} ${es ? 'de' : 'of'} ${p.gallery.length + 1}`} data-alt={`${p.name}, ${es ? 'imagen' : 'image'} ${i + 1} ${es ? 'de' : 'of'} ${p.gallery.length + 1}`}>
              <img src={`/img/w/${g.src.split('/').pop()!.replace(/\.jpg$/, '')}-480.webp`} alt="" loading="lazy" width={g.size[0]} height={g.size[1]} />
            </button>
          ))}
        </div>
      )}
    </div>
    <div class="p-info">
      <p class="eyebrow"><a href={paths.projects(lang)} style="text-decoration:none">← {ui.backToProjects}</a></p>
      <div class="p-logo"><img src={p.logo} alt={`${p.name} logo`} /></div>
      <h1>{p.name}</h1>
      <p class="loc">{p.city}, {p.state} · {countryLabel(p.country, lang)}</p>
      {(descriptions as any)[p.slug] && <p class="p-desc">{(descriptions as any)[p.slug][lang]}</p>}
      {live && <p style="margin-top:16px"><span class="tag live">{ui.status[p.status as keyof typeof ui.status]}</span></p>}
      <dl class="facts num">
        <div><dt>{live ? ui.estimatedCompletion : ui.completionYear}</dt><dd>{p.completionYear ?? (es ? 'Por definir' : 'To be defined')}</dd></div>
        <div><dt>{es ? 'Tipo' : 'Type'}</dt><dd>{typeTxt}</dd></div>
        {p.units != null && <div><dt>{ui.units}</dt><dd>{num(p.units, lang)}</dd></div>}
        <div><dt>{ui.builtArea}</dt><dd>{area(p.builtAreaFt2, lang)}</dd></div>
        {p.masterPlan && <div><dt>{ui.masterPlan}</dt><dd>{masterPlans[p.masterPlan]}</dd></div>}
        {p.partners.length > 0 && <div><dt>{ui.developedWith}</dt><dd>{p.partners.join(', ')}</dd></div>}
      </dl>
      <p class="asof">{es ? `Datos a ${asOfLabel}.` : `Data as of ${asOfLabel}.`}</p>
      {live && (
        <div class="p-actions">
          {p.salesUrl ? (
            <>
              <a class="btn solid arrow" href={p.salesUrl} target="_blank" rel="noopener" data-track="outbound_sales_site" data-track-where={p.slug}>{es ? 'Ir al sitio del proyecto' : 'Go to project website'} ↗</a>
              <a class="btn" href={contactPath(lang, { perfil: 'comprador', proyecto: p.slug })} data-track="cta_click" data-track-where={`project_${p.slug}`}>{es ? 'Solicitar información' : 'Request information'}</a>
            </>
          ) : (
            <a class="btn solid arrow" href={contactPath(lang, { perfil: 'comprador', proyecto: p.slug })} data-track="cta_click" data-track-where={`project_${p.slug}`}>{es ? 'Solicitar información' : 'Request information'}</a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="p-band on-dark">
    <div class="wrap p-band-in">
      <div>
        <p class="eyebrow">{es ? 'Próximos desarrollos' : 'Future developments'}</p>
        <h2>{es ? '¿Tienes un terreno o capital para el siguiente proyecto?' : 'Do you have land or capital for the next project?'}</h2>
        <p>{es ? 'Identificamos, estructuramos y desarrollamos proyectos con propietarios de tierra, socios de capital e instituciones financieras en México y Texas.' : 'We identify, structure and develop projects with landowners, capital partners and financial institutions in Mexico and Texas.'}</p>
      </div>
      <div class="p-band-ctas">
        <a class="btn light arrow" href={contactPath(lang, { perfil: 'terreno' })} data-track="cta_click" data-track-where={`project_band_land_${p.slug}`}>{es ? 'Tengo un terreno' : 'I own land'}</a>
        <a class="btn arrow" href={contactPath(lang, { perfil: 'inversion' })} data-track="cta_click" data-track-where={`project_band_invest_${p.slug}`}>{es ? 'Invertir o asociarse' : 'Invest or partner'}</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      {siblings.length > 0 && (
        <div style="margin-top:24px">
          <h2 class="eyebrow">{ui.masterPlan} · {masterPlans[p.masterPlan!]}</h2>
          <div class="grid" style="margin-top:24px">{siblings.map((s) => <ProjectCard p={s} lang={lang} />)}</div>
        </div>
      )}
      <nav class="pager" aria-label={es ? 'Otros proyectos' : 'Other projects'}>
        {prev ? <a href={paths.project(lang, prev.slug)}><small>← {prev.completionYear}</small>{prev.name}</a> : <span />}
        {next ? <a href={paths.project(lang, next.slug)} style="text-align:right"><small>{next.completionYear ?? (es ? 'En planeación' : 'In planning')} →</small>{next.name}</a> : <span />}
      </nav>
    </div>
  </section>
  {live && (
    <div class="p-sticky" role="region" aria-label={es ? 'Acciones del proyecto' : 'Project actions'}>
      <span>{p.name}</span>
      {p.salesUrl
        ? <a class="btn solid" href={p.salesUrl} target="_blank" rel="noopener" data-track="outbound_sales_site" data-track-where={`sticky_${p.slug}`}>{es ? 'Sitio del proyecto' : 'Project website'} ↗</a>
        : <a class="btn solid" href={contactPath(lang, { perfil: 'comprador', proyecto: p.slug })} data-track="cta_click" data-track-where={`sticky_${p.slug}`}>{es ? 'Solicitar información' : 'Request information'}</a>}
    </div>
  )}
  <script>
    const main = document.getElementById('p-main-img') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.p-thumb').forEach((b, _i, all) => b.addEventListener('click', () => {
      if (!main) return;
      main.srcset = b.dataset.srcset || ''; main.src = b.dataset.src!; main.alt = b.dataset.alt || main.alt; main.width = Number(b.dataset.w); main.height = Number(b.dataset.h);
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }));
  </script>
</Base>
