---
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '../styles/global.css';
import { type Lang, t, paths, contactPath } from '../lib/data';
import ContactCta from '../components/ContactCta.astro';
import siteCfg from '../data/site.json';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current?: 'home' | 'projects' | 'about' | 'contact';
  alt?: string; // path of this page in the other language
  image?: string; // og:image path
  hideCta?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { lang, title, description, current, alt, image, hideCta, jsonLd } = Astro.props;
const ui = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const altHref = alt ?? paths.home(other);
const year = new Date().getFullYear();
const site = 'https://www.pagadesarrollos.com';
const here = new URL(Astro.url.pathname, site).href;
const altAbs = new URL(altHref.split('?')[0], site).href;
const esUrl = lang === 'es' ? here : altAbs;
const enUrl = lang === 'en' ? here : altAbs;
const ogImage = new URL(image ?? '/img/og/paga.jpg', site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'PAGA Desarrollos', url: site,
  logo: `${site}/img/paga-logo-navy.png`, foundingDate: '2001',
  areaServed: ['Monterrey', 'Hermosillo', 'Nuevo Vallarta', 'South Padre Island', 'Port Isabel', 'Port Aransas'],
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {siteCfg.preview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang="es-MX" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="icon" type="image/png" href="/img/paga-icon-navy.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B1B33" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? org)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {siteCfg.preview && <div class="preview" role="note">{ui.previewBanner}</div>}
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={paths.home(lang)} aria-label="PAGA Desarrollos">
          <img src="/img/paga-icon-navy.png" alt="" width="42" height="42" />
          <span>PAGA<small>DESARROLLOS</small></span>
        </a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <a href={paths.projects(lang)} aria-current={current === 'projects' ? 'page' : undefined}>{ui.nav.projects}</a>
          <a class="hide-xs" href={paths.about(lang)} aria-current={current === 'about' ? 'page' : undefined}>{ui.nav.about}</a>
          <a class="lang" href={altHref} hreflang={other} lang={other} data-track="lang_switch">{other.toUpperCase()}</a>
          <a class="btn solid nav-cta" href={contactPath(lang)} aria-current={current === 'contact' ? 'page' : undefined} data-track="cta_click" data-track-where="header">{lang === 'es' ? 'Contacto' : 'Contact'}</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
      {!hideCta && <ContactCta lang={lang} />}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="top">
          <div>
            <img class="logo" src="/img/paga-logo-white.png" alt="PAGA Desarrollos" width="120" height="108" />
          </div>
          <nav aria-label={lang === 'es' ? 'Sitio' : 'Site'}>
            <p class="fh">{lang === 'es' ? 'Sitio' : 'Site'}</p>
            <a href={paths.projects(lang)}>{ui.nav.projects}</a>
            <a href={paths.about(lang)}>{ui.nav.about}</a>
            <a href={`${paths.about(lang)}#equipo`}>{ui.nav.team}</a>
            <a href={contactPath(lang)}>{lang === 'es' ? 'Contacto' : 'Contact'}</a>
          </nav>
          <div>
            <p class="fh">{lang === 'es' ? 'Presencia' : 'Locations'}</p>
            <p>{lang === 'es' ? 'Monterrey · Hermosillo · Nuevo Vallarta' : 'Monterrey · Hermosillo · Nuevo Vallarta'}<br />South Padre Island · Port Isabel · Port Aransas</p>
          </div>
        </div>
        <div class="bottom">
          <span>© {year} PAGA Desarrollos</span>
          <div class="legal">
            <a href={paths.legal(lang, 'aviso-de-privacidad')}>{ui.footer.privacy}</a>
            <a href={paths.legal(lang, 'aviso-de-cookies')}>{ui.footer.cookies}</a>
            <a href={paths.legal(lang, 'terminos')}>{ui.footer.terms}</a>
            <a href={paths.legal(lang, 'canales-oficiales')}>{ui.footer.officialChannels}</a>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      // lead source: first page, referrer and campaign of this visit (sessionStorage only, cleared when the tab closes)
      try {
        if (!sessionStorage.getItem('paga_src')) {
          var u = new URL(location.href), ref = document.referrer && new URL(document.referrer).host !== location.host ? document.referrer.split('?')[0] : '';
          var utm = ['utm_source', 'utm_medium', 'utm_campaign'].map(function (k) { return u.searchParams.get(k) || ''; }).filter(Boolean).join(' / ');
          sessionStorage.setItem('paga_src', JSON.stringify({ landing: u.pathname, ref: ref, utm: utm }));
        }
      } catch (e) {}
    </script>
  </body>
</html>
