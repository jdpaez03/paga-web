---
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '../styles/global.css';
import { type Lang, t, paths } from '../lib/data';
import site from '../data/site.json';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current?: 'home' | 'projects' | 'about';
  alt?: string; // path of this page in the other language
}
const { lang, title, description, current, alt } = Astro.props;
const ui = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const altHref = alt ?? paths.home(other);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/img/paga-icon-navy.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    {site.preview && <div class="preview" role="note">{ui.previewBanner}</div>}
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={paths.home(lang)} aria-label="PAGA Desarrollos">
          <img src="/img/paga-icon-navy.png" alt="" width="42" height="42" />
          <span>PAGA<small>DESARROLLOS</small></span>
        </a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <a href={paths.projects(lang)} aria-current={current === 'projects' ? 'page' : undefined}>{ui.nav.projects}</a>
          <a class="hide-sm" href={`${paths.projects(lang)}#linea-del-tiempo`}>{ui.timeline}</a>
          <a href={paths.about(lang)} aria-current={current === 'about' ? 'page' : undefined}>{ui.nav.about}</a>
          <a class="hide-sm" href={`${paths.home(lang)}#socios`}>{ui.nav.partners}</a>
          <a class="lang" href={altHref} hreflang={other} lang={other}>{other.toUpperCase()}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="top">
          <div>
            <img class="logo" src="/img/paga-logo-white.png" alt="PAGA Desarrollos" width="120" height="108" />
          </div>
          <nav aria-label={lang === 'es' ? 'Sitio' : 'Site'}>
            <p class="fh">{lang === 'es' ? 'Sitio' : 'Site'}</p>
            <a href={paths.projects(lang)}>{ui.nav.projects}</a>
            <a href={paths.about(lang)}>{ui.nav.about}</a>
            <a href={`${paths.home(lang)}#socios`}>{ui.nav.partners}</a>
          </nav>
          <div>
            <p class="fh">{lang === 'es' ? 'Presencia' : 'Locations'}</p>
            <p>{lang === 'es' ? 'Monterrey · Hermosillo · Nuevo Vallarta' : 'Monterrey · Hermosillo · Nuevo Vallarta'}<br />South Padre Island · Port Isabel · Port Aransas</p>
          </div>
        </div>
        <div class="bottom">
          <span>© {year} PAGA Desarrollos</span>
          <div class="legal">
            <a href="#">{ui.footer.privacy}</a>
            <a href="#">{ui.footer.cookies}</a>
            <a href="#">{ui.footer.terms}</a>
            <a href="#">{ui.footer.officialChannels}</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
