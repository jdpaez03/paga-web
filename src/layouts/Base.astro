---
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
// las rutas con hash de los tres archivos de Jost, para poder precargarlos
import jost300 from '@fontsource/jost/files/jost-latin-300-normal.woff2?url';
import jost400 from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
import jost500 from '@fontsource/jost/files/jost-latin-500-normal.woff2?url';
import '../styles/global.css';
import { type Lang, t, paths, contactPath, offices, showTeam } from '../lib/data';
import ContactCta from '../components/ContactCta.astro';
import siteCfg from '../data/site.json';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current?: 'home' | 'projects' | 'about' | 'contact';
  alt?: string; // path of this page in the other language
  image?: string; // og:image path
  hideCta?: boolean;
  /* slug del proyecto de esta pagina, si lo hay: viaja a la banda de contacto y de ahi al
     formulario como ?proyecto=. Sin esto, las 36 fichas mandaban el lead sin decir de que
     desarrollo venia, y es el campo que crm.php ya sabe traducir contra el catalogo de la Suite. */
  ctaProject?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { lang, title, description, current, alt, image, hideCta, ctaProject, jsonLd } = Astro.props;
const ui = t(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const altHref = alt ?? paths.home(other);
const year = new Date().getFullYear();
const site = 'https://www.pagadesarrollos.com';
const here = new URL(Astro.url.pathname, site).href;
const altAbs = new URL(altHref.split('?')[0], site).href;
const esUrl = lang === 'es' ? here : altAbs;
const enUrl = lang === 'en' ? here : altAbs;
const ogImage = new URL(image ?? '/img/og/paga.jpg', site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'PAGA Desarrollos', url: site,
  logo: `${site}/img/paga-logo-navy.png`, foundingDate: '2001',
  areaServed: ['Monterrey', 'Hermosillo', 'Nuevo Vallarta', 'South Padre Island', 'Port Isabel', 'Port Aransas'],
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Las tres variantes de Jost se usan en cuanto pinta la pagina: el eyebrow en 500, el
        titulo en 300 y el texto en 400. Sin preload el navegador no las descubre hasta que
        termina de bajar la hoja de estilos, y el texto aparece primero en la tipografia del
        sistema. Cormorant no se precarga: es una frase y Georgia la sustituye bien. */}
    <link rel="preload" as="font" type="font/woff2" href={jost300} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jost500} crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {siteCfg.preview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={here} />
    <link rel="alternate" hreflang="es-MX" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    {/* El navegador pide /favicon.ico aunque no se declare, y recibia un 404. Lleva 16, 32 y 48 px,
        que son los tres tamaños que de verdad se usan, y asi se declaran: un navegador que honre
        `sizes` no lo consideraba para un hueco de 48 px porque decia solo 32.

        El icono blanco va para la pestaña en tema oscuro: el navy #13294b sobre la barra oscura
        de Chrome (#202124) da 1.11:1, o sea invisible.

        El orden importa, y por eso el navy va al final y con su propia media query. El soporte de
        `media` en rel=icon es parcial —Firefox no lo implementa—, y un navegador que lo ignora se
        queda con el ultimo declarado. Con el blanco al final, ese navegador pintaba blanco sobre
        la barra clara (#f1f3f4): 1.12:1, el espejo exacto del problema que esto viene a arreglar,
        y en el modo que usa mas gente. Con el navy al final se queda como estaba antes, que es lo
        peor que puede pasarle, mientras los que si honran `media` conservan el arreglo: la media
        query filtra los candidatos primero y el orden solo desempata entre los que quedan.

        La salida buena es un SVG unico con la media query dentro, pero no hay fuente vectorial de
        la marca todavia: esta pendiente de Direccion. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/webp" href="/img/paga-icon-white.webp" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/webp" href="/img/paga-icon-navy.webp" media="(prefers-color-scheme: light)" />
    {/* iOS descarta el canal alfa al guardar el sitio en la pantalla de inicio: sin este archivo
        ponia una captura de la página. Fondo papel opaco, con el margen que el sistema espera. */}
    <link rel="apple-touch-icon" href="/img/paga-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PAGA Desarrollos" />
    {/* sin og:site_name, la tarjeta compartida encabeza con el dominio pelado */}
    <meta property="og:site_name" content="PAGA Desarrollos" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B1B33" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? org)} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {siteCfg.preview && <div class="preview" role="note">{ui.previewBanner}</div>}
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={paths.home(lang)} aria-label="PAGA Desarrollos">
          <img src="/img/paga-icon-navy.webp" alt="" width="42" height="42" />
          <span>PAGA<small>DESARROLLOS</small></span>
        </a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          <a href={paths.projects(lang)} aria-current={current === 'projects' ? 'page' : undefined}>{ui.nav.projects}</a>
          <a href={paths.about(lang)} aria-current={current === 'about' ? 'page' : undefined}>{ui.nav.about}</a>
          <a class="lang" href={altHref} hreflang={other} lang={other} aria-label={other === 'en' ? 'Switch to English' : 'Cambiar a español'} data-track="lang_switch">{other.toUpperCase()}</a>
          <a class="btn solid nav-cta" href={contactPath(lang)} aria-current={current === 'contact' ? 'page' : undefined} data-track="cta_click" data-track-where="header">{lang === 'es' ? 'Contacto' : 'Contact'}</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
      {!hideCta && <ContactCta lang={lang} project={ctaProject} />}
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="top">
          <div>
            <a href={paths.home(lang)} aria-label={lang === 'es' ? 'PAGA Desarrollos, ir al inicio' : 'PAGA Desarrollos, go to home'}>
              {/* 120x107, no 120x108: el maestro es 600x537, asi que 108 estiraba el logotipo medio
                  punto porcentual en vertical. El archivo se declara con la proporcion que tiene. */}
              <img class="logo" src="/img/paga-logo-white.webp" alt="PAGA Desarrollos" width="120" height="107" loading="lazy" decoding="async" />
            </a>
          </div>
          <nav aria-label={lang === 'es' ? 'Sitio' : 'Site'}>
            <a href={paths.projects(lang)}>{ui.nav.projects}</a>
            <a href={paths.about(lang)}>{ui.nav.about}</a>
            {/* mientras el equipo siga en borrador no se publica, y esta liga apuntaria a un ancla que no existe */}
            {showTeam && <a href={`${paths.about(lang)}#equipo`}>{ui.nav.team}</a>}
            <a href={contactPath(lang)}>{lang === 'es' ? 'Contacto' : 'Contact'}</a>
          </nav>
          <div class="loc">
            <p class="fh">{lang === 'es' ? 'Presencia' : 'Locations'}</p>
            <p>{lang === 'es' ? 'Monterrey · Hermosillo · Nuevo Vallarta' : 'Monterrey · Hermosillo · Nuevo Vallarta'}<br />South Padre Island · Port Isabel · Port Aransas</p>
            {offices.length > 0 && (
              <address class="addr">{offices.map((o) => (
                <span>{o.address ?? <>
                  {o.phone && <a href={`tel:${o.phone.replace(/[^\d+]/g, '')}`}>{o.phone}</a>}
                  {o.phone && o.email && ' · '}
                  {o.email && <a href={`mailto:${o.email}`}>{o.email}</a>}
                </>}</span>
              ))}</address>
            )}
          </div>
        </div>
        <div class="bottom">
          <span>© {year} PAGA Desarrollos</span>
          <div class="legal">
            <a href={paths.legal(lang, 'aviso-de-privacidad')}>{ui.footer.privacy}</a>
            <a href={paths.legal(lang, 'aviso-de-cookies')}>{ui.footer.cookies}</a>
            <a href={paths.legal(lang, 'terminos')}>{ui.footer.terms}</a>
            <a href={paths.legal(lang, 'canales-oficiales')}>{ui.footer.officialChannels}</a>
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      // lead source: first page, referrer and campaign of this visit (sessionStorage only, cleared when the tab closes)
      try {
        if (!sessionStorage.getItem('paga_src')) {
          var u = new URL(location.href), ref = document.referrer && new URL(document.referrer).host !== location.host ? document.referrer.split('?')[0] : '';
          var utm = ['utm_source', 'utm_medium', 'utm_campaign'].map(function (k) { return u.searchParams.get(k) || ''; }).filter(Boolean).join(' / ');
          sessionStorage.setItem('paga_src', JSON.stringify({ landing: u.pathname, ref: ref, utm: utm }));
        }
      } catch (e) {}
    </script>
  </body>
</html>
