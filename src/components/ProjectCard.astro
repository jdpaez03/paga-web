---
import { type Lang, type Project, t, paths, typeLabel, tx, srcset, area, num } from '../lib/data';
interface Props { p: Project; lang: Lang; eager?: boolean }
const { p, lang, eager } = Astro.props;
const ui = t(lang);
const es = lang === 'es';
const live = p.status !== 'delivered';
const year = p.completionYear ? (live ? `${es ? 'Estimado' : 'Est.'} ${p.completionYear}` : `${p.completionYear}`) : '';
// Los dos numeros con los que se compara la escala de un desarrollo. Las unidades solo donde las
// hay: un centro comercial o un edificio de oficinas no se mide en unidades.
const scale = [
  p.units ? `${num(p.units, lang)} ${es ? 'unidades' : 'homes'}` : '',
  area(p.builtAreaFt2, lang),
].filter(Boolean).join(' · ');
---
<a class="card" href={paths.project(lang, p.slug)} data-country={p.country} data-status={p.status} data-type={p.type} data-city={p.city}>
  {/* Si la imagen es un render y no obra terminada, se dice. En un portafolio que mezcla
      entregas con obra en curso es la señal de honestidad más barata que hay. */}
  <div class="ph">{p.imagesAreRenders && <span class="render-tag">{lang === 'es' ? 'Render' : 'Rendering'}</span>}<img src={p.image} srcset={srcset(p.image, p.imageSize[0])} sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw" alt={p.name} width={p.imageSize[0]} height={p.imageSize[1]} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
  <h3>{p.name}</h3>
  <div class="meta">
    <span>{p.city}, {p.state}</span>
    <span>{tx(typeLabel[p.type], lang)}</span>
    {year && <span class="num">{year}</span>}
  </div>
  <p class="scale num">{scale}</p>
  {live && <p style="margin-top:10px"><span class="tag live">{ui.status[p.status as keyof typeof ui.status]}</span></p>}
</a>
