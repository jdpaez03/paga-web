---
import { type Lang, figures, area, num, asOf } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const f = figures();
const d = new Date(asOf + 'T12:00:00');
const asOfLabel = d.toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-US', { month: 'long', year: 'numeric' });
const es = lang === 'es';
---
<div class="figures num">
  <div class="figure"><strong>{f.years}</strong><span>{es ? 'años desde 2001' : 'years, since 2001'}</span></div>
  <div class="figure"><strong>{f.developments}</strong><span>{es ? 'desarrollos en México y Estados Unidos, incluidos los que están en curso' : 'developments in Mexico and the United States, including those underway'}</span></div>
  <div class="figure"><strong>{f.delivered}</strong><span>{es ? 'entregados' : 'delivered'}</span></div>
  <div class="figure"><strong>{area(f.totalFt2, lang, 1000).replace(/ (m²|ft²)$/, '')}</strong><span>{es ? 'm² de superficie construida y en desarrollo' : 'ft² of built area, completed and in development'}</span></div>
</div>
<p class="asof">{es ? `Cifras a ${asOfLabel}, con base en los desarrollos documentados.` : `Figures as of ${asOfLabel}, based on documented developments.`}</p>
